# ============================================================
# Variables de entorno del compose (uso local / académico)
# Este archivo NO contiene secretos reales: son credenciales
# de desarrollo para los contenedores.
# ============================================================

# ---------- Puertos publicados en el host ----------
FRONTEND_PORT=8080
BACKEND_PORT=8000
FORWARD_DB_PORT=13306
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
VITE_API_URL=/api

# ---------- MariaDB ----------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=portafolio
DB_USERNAME=portafolio
DB_PASSWORD=portafolio
DB_ROOT_PASSWORD=root

# ---------- Laravel ----------
APP_NAME=PortafolioWeb
APP_ENV=local
APP_KEY=base64:r/kybj9gog1aTtLI47cvhfk7CGBzinM99HgDkQidB4g=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Carga los seeders solo si la base está vacía
SEED_DATABASE=true

# ---------- Correo (Mailpit) ----------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=contacto@portafolio.test
MAIL_FROM_NAME=PortafolioWeb

# ---------- Mailpit ----------
TZ=America/Mexico_City
MP_MAX_MESSAGES=100
